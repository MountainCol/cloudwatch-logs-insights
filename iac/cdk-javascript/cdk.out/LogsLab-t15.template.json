        "#!/bin/bash\nset -x\ndnf install -y httpd rsyslog mariadb105\nsystemctl enable --now rsyslog\nsystemctl enable --now httpd\necho '<html><body><h1>Log collection lab</h1><p>A simple web page hosted on Amazon Linux (trainee t15).</p></body></html>' > /var/www/html/index.html\nmkdir -p /opt/lab\necho \"DB_HOST=",
